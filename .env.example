# PromptPilot Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.

# --- LLM Provider Configuration ---
# Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Active model identifier (recommended: gemini-3.5-flash or gemini-3.1-pro-preview)
LLM_MODEL=gemini-3.5-flash

# Optional: Separate specialized model identifiers (defaults to LLM_MODEL if unset)
PROMPT_ANALYZER_MODEL=gemini-3.5-flash
PROMPT_GENERATOR_MODEL=gemini-3.5-flash
RESPONSE_GENERATOR_MODEL=gemini-3.5-flash
EVALUATOR_MODEL=gemini-3.5-flash

# --- Database Configuration ---
DATABASE_PATH=data/promptpilot.db

# --- Safety & Cost Controls ---
MAX_INPUT_CHARS=10000
MAX_PROMPT_CHARS=3000
MAX_VARIANTS_PER_RUN=5
MAX_BATCH_TEST_CASES=10
RATE_LIMIT_COOLDOWN_SECONDS=2.0

# --- Logging & Diagnostics ---
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
